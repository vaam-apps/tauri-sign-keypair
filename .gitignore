# Miscellaneous
*.log
*.swp
.DS_Store
.idea/
*.iml

# Rust. Unanchored: the example app has its own target/ under
# examples/tauri-app/src-tauri/.
target/
# A plugin is a library: Cargo.lock pins a consumer's dependency graph, which
# is the app's decision to make, not this crate's.
/Cargo.lock

# Node / the JS API package
node_modules/
/dist-js/
# The example's Vite output, and the schemas its Tauri build generates.
/examples/tauri-app/dist/
/examples/tauri-app/src-tauri/gen/

# Generated by build.rs from the `tauri` crate's own mobile API — a copy of
# someone else's source, refreshed on every build. `/.tauri/` is the iOS one:
# `ios/Package.swift` resolves it at `../.tauri/tauri-api`, so it lands at the
# repository root rather than under `ios/`.
/.tauri/
/android/.tauri/
/ios/Package.resolved

# SwiftPM / Xcode
.build/
.swiftpm/
*.xcuserstate
/darwin_tests/.build/

# Gradle / Android
/android/build/
/android/.gradle/
/android/local.properties
