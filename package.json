{
  "name": "tauri-plugin-sign-keypair-api",
  "version": "0.1.0",
  "description": "Hardware-backed ECDSA P-256 (ES256) signing for device-bound authentication in Tauri v2 apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaam-apps/tauri-sign-keypair.git"
  },
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    "types": "./dist-js/index.d.ts",
    "import": "./dist-js/index.js",
    "require": "./dist-js/index.cjs"
  },
  "files": [
    "dist-js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.34.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "fake-indexeddb": "^6.0.0"
  }
}
