{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sign-keypair example",
  "version": "0.1.0",
  "identifier": "app.vaam.signkeypair.example",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tauri-plugin-sign-keypair",
        "width": 820,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  }
}
